{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/ClientClockCases.json",
  "description": "client/clock-cases.json: every wait a Xynolog client makes, each one's end stated on a clock its caller moves.",
  "allOf": [
    {
      "$ref": "https://xynolog.org/protocol/CaseTable.json"
    }
  ],
  "type": "object",
  "properties": {
    "$comment": true,
    "cases": {
      "type": "array",
      "minItems": 1,
      "description": "The cases.",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "enum": [
              "degradedStream",
              "deviceGrant",
              "discovery",
              "handoffLinger",
              "heldJobStall",
              "invalidationWindow",
              "jobFollower",
              "jobPoll",
              "jobPollTimeout",
              "refusedAgentGrant",
              "refusedAgentSignIn",
              "refusedBusRequest",
              "refusedStream",
              "renewal",
              "saveDebounce",
              "scopeLetGo",
              "scopeTaken",
              "timedOutBusRequest",
              "unansweredEmit",
              "unansweredRequest",
              "unansweredStream",
              "unreachableAgentSignIn"
            ],
            "description": "What the runner builds and what it counts."
          },
          "case": {
            "type": "string",
            "minLength": 1,
            "description": "What the case is."
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "description": "The steps, run in order.",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "settle",
                    "act"
                  ],
                  "description": "`settle` lets what is ready run, moving no time; `act` does the subject's action, then settles."
                },
                {
                  "title": "Counted",
                  "type": "object",
                  "properties": {
                    "counted": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "How many times what the subject counts has happened since the case began."
                    }
                  },
                  "required": [
                    "counted"
                  ],
                  "additionalProperties": false
                },
                {
                  "title": "Pass",
                  "type": "object",
                  "properties": {
                    "pass": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "description": "A duration in milliseconds."
                        },
                        {
                          "description": "A duration named by a timing.",
                          "type": "object",
                          "properties": {
                            "timing": {
                              "type": "string",
                              "pattern": "^[a-z][A-Za-z]*(\\.[a-z][A-Za-z]*)?$",
                              "description": "A name of client/timing.json, or a retry budget's name, a dot and one of its members."
                            },
                            "times": {
                              "type": "number",
                              "description": "What the timing is scaled by."
                            },
                            "plusMs": {
                              "type": "integer",
                              "description": "The milliseconds the scaled timing is moved by."
                            }
                          },
                          "required": [
                            "timing"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "pass"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "given": {
            "description": "What the subject leaves open.",
            "type": "object",
            "properties": {
              "retryAfterSeconds": {
                "type": "integer",
                "minimum": 0,
                "description": "The `Retry-After` a refusal carries, in seconds."
              },
              "lifetimeSeconds": {
                "type": "integer",
                "minimum": 0,
                "description": "How long an issued access token lives, in seconds."
              },
              "intervalSeconds": {
                "type": "integer",
                "minimum": 0,
                "description": "The `interval` the device authorization answers with, in seconds."
              },
              "answers": {
                "type": "array",
                "minItems": 1,
                "description": "What the token endpoint answers each ask with, the last repeating.",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]+(_[a-z]+)*$",
                  "description": "An OAuth error code."
                }
              },
              "status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599,
                "description": "The status the server a subject names answers with."
              }
            },
            "required": [],
            "additionalProperties": false,
            "minProperties": 1
          }
        },
        "required": [
          "subject",
          "case",
          "steps"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cases"
  ],
  "additionalProperties": false
}
