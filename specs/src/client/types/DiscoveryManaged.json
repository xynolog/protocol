{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/DiscoveryManaged.json",
  "title": "DiscoveryManaged",
  "description": "The knowledge bases a launcher manages: none is a launcher that manages nothing.",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "managed"
      ]
    },
    "kbs": {
      "type": "array",
      "items": {
        "$ref": "https://xynolog.org/protocol/DiscoveredKB.json"
      },
      "description": "Each knowledge base, as the document lists it."
    }
  },
  "required": [
    "kind",
    "kbs"
  ],
  "additionalProperties": false
}
