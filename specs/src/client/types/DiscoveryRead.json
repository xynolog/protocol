{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/DiscoveryRead.json",
  "title": "DiscoveryRead",
  "description": "What one read of a launcher's discovery document gave, told apart by `kind`: no launcher was found, the knowledge bases one manages, or nothing changed since the last read. A launcher that manages none is not an absent one.",
  "oneOf": [
    {
      "type": "object",
      "description": "No launcher was found, and why.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "absent"
          ]
        },
        "reason": {
          "$ref": "https://xynolog.org/protocol/DiscoveryAbsentReason.json",
          "description": "Why."
        },
        "diagnostic": {
          "type": "string",
          "minLength": 1,
          "description": "What was wrong, in words, when there is more to say."
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "The knowledge bases a launcher manages: none is a launcher that manages nothing.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "managed"
          ]
        },
        "kbs": {
          "type": "array",
          "items": {
            "$ref": "https://xynolog.org/protocol/DiscoveredKB.json"
          },
          "description": "Each knowledge base, as the document lists it."
        }
      },
      "required": [
        "kind",
        "kbs"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "Nothing changed since the last read.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "unchanged"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  ],
  "discriminator": {
    "propertyName": "kind"
  }
}
