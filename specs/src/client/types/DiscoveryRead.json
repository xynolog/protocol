{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/DiscoveryRead.json",
  "title": "DiscoveryRead",
  "description": "What one read of a launcher's discovery document gave: a DiscoveryState's absent or managed, or that nothing changed since the last read. Told apart by `kind`, as DiscoveryState's are.",
  "oneOf": [
    {
      "$ref": "https://xynolog.org/protocol/DiscoveryAbsent.json"
    },
    {
      "$ref": "https://xynolog.org/protocol/DiscoveryManaged.json"
    },
    {
      "$ref": "https://xynolog.org/protocol/DiscoveryUnchanged.json"
    }
  ],
  "discriminator": {
    "propertyName": "kind",
    "mapping": {
      "absent": "https://xynolog.org/protocol/DiscoveryAbsent.json",
      "managed": "https://xynolog.org/protocol/DiscoveryManaged.json",
      "unchanged": "https://xynolog.org/protocol/DiscoveryUnchanged.json"
    }
  }
}
