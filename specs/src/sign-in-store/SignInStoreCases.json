{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/SignInStoreCases.json",
  "description": "sign-in-store/cases.json: where the launcher's state home is, and what a renewal of a kept sign-in writes and gives.",
  "allOf": [
    {
      "$ref": "https://xynolog.org/protocol/CaseTable.json"
    }
  ],
  "type": "object",
  "properties": {
    "$comment": true,
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "why": {
            "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
          },
          "os": {
            "type": "string",
            "minLength": 1,
            "description": "`macos`, `windows`, or any other system."
          },
          "home": {
            "type": [
              "string",
              "null"
            ],
            "description": "The home directory, or null when it is not set."
          },
          "xdgStateHome": {
            "type": [
              "string",
              "null"
            ],
            "description": "XDG_STATE_HOME, or null when it is not set."
          },
          "localAppData": {
            "type": "string",
            "description": "LOCALAPPDATA, or left out when it is not set."
          },
          "dir": {
            "type": [
              "string",
              "null"
            ],
            "description": "The state home, or null when there is none."
          }
        },
        "required": [
          "why",
          "os",
          "home",
          "xdgStateHome",
          "dir"
        ],
        "additionalProperties": false
      }
    },
    "renewals": {
      "description": "What a renewal of a kept sign-in writes and gives.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "why": {
            "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
          },
          "kept": {
            "description": "A sign-in: its access token and its refresh token.",
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "minLength": 1,
                "description": "The access token."
              },
              "refreshToken": {
                "type": "string",
                "minLength": 1,
                "description": "The refresh token."
              }
            },
            "required": [
              "token",
              "refreshToken"
            ],
            "additionalProperties": false
          },
          "holding": {
            "type": [
              "string",
              "null"
            ],
            "description": "The access token the renewer holds, or null for none."
          },
          "meanwhile": {
            "type": [
              "object",
              "null"
            ],
            "description": "What another program does to the stack's sign-in, or null for nothing.",
            "properties": {
              "when": {
                "type": "string",
                "enum": [
                  "before",
                  "during"
                ]
              },
              "does": {
                "type": "string",
                "enum": [
                  "renews",
                  "signs-out"
                ]
              },
              "theirs": {
                "$ref": "#/properties/renewals/items/properties/kept"
              }
            },
            "required": [
              "when",
              "does"
            ],
            "additionalProperties": false
          },
          "expired": {
            "description": "The access tokens minted already expired.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "issues": {
            "description": "What the issuer answers a grant with: no refresh token when it rotates none.",
            "type": "object",
            "properties": {
              "token": {
                "$ref": "#/properties/renewals/items/properties/kept/properties/token"
              },
              "refreshToken": {
                "$ref": "#/properties/renewals/items/properties/kept/properties/refreshToken"
              }
            },
            "required": [
              "token"
            ],
            "additionalProperties": false
          },
          "spends": {
            "type": [
              "string",
              "null"
            ],
            "description": "The refresh token the renewal's grant presents, or null when it makes no grant."
          },
          "leaves": {
            "description": "What the store then holds for the stack, or null for nothing.",
            "anyOf": [
              {
                "$ref": "#/properties/renewals/items/properties/kept"
              },
              {
                "type": "null"
              }
            ]
          },
          "gives": {
            "type": [
              "string",
              "null"
            ],
            "description": "The access token the renewal gives its holder, or null for none."
          }
        },
        "required": [
          "why",
          "kept",
          "holding",
          "meanwhile",
          "expired",
          "issues",
          "spends",
          "leaves",
          "gives"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cases",
    "renewals"
  ],
  "additionalProperties": false
}
