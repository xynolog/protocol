{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/ControlMethods.json",
  "description": "control/methods.json: the control API's methods and notifications, and the schemas each names.",
  "type": "object",
  "properties": {
    "$comment": {
      "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/$comment"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^https://xynolog\\.org/protocol/[A-Z][A-Za-z]*\\.json$",
      "description": "A schema of control/, by its $id."
    },
    "errorData": {
      "$ref": "#/properties/apiVersion"
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z]*(\\.[a-z][A-Za-z]*)+$",
            "description": "The method's name."
          },
          "params": {
            "$ref": "#/properties/apiVersion"
          },
          "result": {
            "$ref": "#/properties/apiVersion"
          },
          "exclusive": {
            "type": "boolean",
            "description": "Whether a request waits for every other exclusive request to end, and holds the others off until it does."
          },
          "sends": {
            "type": "array",
            "uniqueItems": true,
            "description": "The notifications a request may send besides notifications/progress.",
            "items": {
              "$ref": "#/properties/notifications/items/properties/name"
            }
          },
          "docs": {
            "type": "string",
            "minLength": 1,
            "description": "What the method does."
          }
        },
        "required": [
          "name",
          "params",
          "result",
          "exclusive",
          "sends",
          "docs"
        ],
        "additionalProperties": false
      }
    },
    "notifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^notifications/[a-z][A-Za-z]*$",
            "description": "A notification's name."
          },
          "from": {
            "$ref": "https://xynolog.org/protocol/ControlSender.json",
            "description": "Which side sends it."
          },
          "params": {
            "$ref": "#/properties/apiVersion"
          },
          "docs": {
            "type": "string",
            "minLength": 1,
            "description": "What it says."
          }
        },
        "required": [
          "name",
          "from",
          "params",
          "docs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$comment",
    "apiVersion",
    "errorData",
    "methods",
    "notifications"
  ],
  "additionalProperties": false
}
