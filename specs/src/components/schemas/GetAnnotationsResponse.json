{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/GetAnnotationsResponse.json",
  "type": "object",
  "properties": {
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "https://xynolog.org/protocol/Annotation.json"
      }
    },
    "total": {
      "type": "number",
      "description": "Total number of annotations"
    },
    "motivation": {
      "$ref": "https://xynolog.org/protocol/Motivation.json",
      "description": "Motivation filter applied (if any)"
    }
  },
  "required": [
    "annotations",
    "total"
  ]
}
